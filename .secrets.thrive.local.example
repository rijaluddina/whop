# Salin menjadi .secrets.thrive.local lalu ganti setiap nilai contoh.
WHOP_CLIENT_SECRET=GANTI_DENGAN_CLIENT_SECRET
WHOP_WEBHOOK_SECRET=ws_GANTI_DENGAN_WEBHOOK_SECRET
RESEND_API_KEY=re_GANTI_DENGAN_API_KEY_RESEND
ESTIMATE_EMAIL_FROM=hello@domain-terverifikasi.com
# SESSION_SECRET dibuat oleh scripts/set-production-secrets.sh jika belum ada.
# Untuk menjalankan lokal sebelum skrip itu, buat nilai acak dan tambahkan:
# SESSION_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
